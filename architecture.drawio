  <diagram id="component-arch" name="3. Component Architecture (C4 L3)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="c3-title" value="SDLC Workboard - Component Architecture (C4 Level 3)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3-subtitle" value="Internal component breakdown within the FastAPI Application and Service Layer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Main Container: FastAPI App -->
        <mxCell id="box-app" value="&lt;b&gt;app.main (FastAPI Application Router &amp; Handlers)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="340" height="670" as="geometry" />
        </mxCell>

        <mxCell id="ep-overview" value="&lt;b&gt;Overview Route Handler&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /&lt;/code&gt;&lt;br&gt;Renders overview dashboard, phase readiness, role summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="40" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep-board" value="&lt;b&gt;Board Route Handler&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /board&lt;/code&gt;&lt;br&gt;Filters by role/phase/status, renders 8-column Kanban" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="110" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep-tasks" value="&lt;b&gt;Task &amp; Gate Route Handlers&lt;/b&gt;&lt;br&gt;&lt;code&gt;POST /tasks, GET /tasks/{id}&lt;/code&gt;&lt;br&gt;&lt;code&gt;POST /tasks/{id}/(status|comments|handoff|contract|gates)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="180" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ep-jobs" value="&lt;b&gt;Architecture Jobs Handler&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /jobs, POST /jobs, POST /jobs/{id}/state&lt;/code&gt;&lt;br&gt;Tracks input specs, output artifacts, test states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="260" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep-docs" value="&lt;b&gt;Document Registry Handler&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /documents, POST /documents&lt;/code&gt;&lt;br&gt;&lt;code&gt;GET /documents/{id}, POST /documents/{id}/status&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="330" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ep-knowledge" value="&lt;b&gt;Knowledge Base Handler&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /knowledge?department=&amp;q=&lt;/code&gt;&lt;br&gt;Constrains query strictly to selected department" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="410" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep-infra" value="&lt;b&gt;Infrastructure / Filters&lt;/b&gt;&lt;br&gt;• ValidationError handler (400)&lt;br&gt;• LookupError handler (404)&lt;br&gt;• Jinja2Templates context injector&lt;br&gt;• StaticFiles mount (/static)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="480" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ep-di" value="&lt;b&gt;Dependency Injection&lt;/b&gt;&lt;br&gt;&lt;code&gt;get_conn() -&gt; sqlite3.Connection&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;align=center;fontSize=11;" vertex="1" parent="box-app">
          <mxGeometry x="20" y="580" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Services Layer Container -->
        <mxCell id="box-services" value="&lt;b&gt;app.services (Domain Logic &amp; Parameterized SQL)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="380" height="670" as="geometry" />
        </mxCell>

        <mxCell id="svc-metrics" value="&lt;b&gt;Dashboard &amp; Metrics Service&lt;/b&gt;&lt;br&gt;• &lt;code&gt;dashboard_summary(conn)&lt;/code&gt;&lt;br&gt;• &lt;code&gt;phase_readiness(conn)&lt;/code&gt;&lt;br&gt;• &lt;code&gt;current_work_by_role(conn)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="40" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="svc-tasks" value="&lt;b&gt;SDLC Task &amp; Gate Service&lt;/b&gt;&lt;br&gt;• &lt;code&gt;list_tasks, get_task, create_task&lt;/code&gt;&lt;br&gt;• &lt;code&gt;update_status&lt;/code&gt; (Validates Done requires all exit gates)&lt;br&gt;• &lt;code&gt;set_gate_item&lt;/code&gt; (Atomic toggle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="110" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="svc-collab" value="&lt;b&gt;Collaboration &amp; Handoff Service&lt;/b&gt;&lt;br&gt;• &lt;code&gt;add_comment&lt;/code&gt; (update, blocker, decision)&lt;br&gt;• &lt;code&gt;record_handoff&lt;/code&gt; (Accountability transfer)&lt;br&gt;• &lt;code&gt;update_contract&lt;/code&gt; (Evidence, risks, ADRs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="195" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="svc-docs" value="&lt;b&gt;Document Lifecycle Service&lt;/b&gt;&lt;br&gt;• &lt;code&gt;list_documents&lt;/code&gt; (Multi-filter search)&lt;br&gt;• &lt;code&gt;create_document, get_document&lt;/code&gt;&lt;br&gt;• &lt;code&gt;update_document_status&lt;/code&gt; (Draft → Review → Approved)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="280" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="svc-knowledge" value="&lt;b&gt;Department Knowledge Service&lt;/b&gt;&lt;br&gt;• Scoped filtering by single department&lt;br&gt;• &lt;code&gt;knowledge_mode()&lt;/code&gt; -&gt; Manual Only disclosure&lt;br&gt;• No outbound network requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="365" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="svc-jobs" value="&lt;b&gt;Architecture Job Service&lt;/b&gt;&lt;br&gt;• &lt;code&gt;list_jobs, create_job, update_job_state&lt;/code&gt;&lt;br&gt;• States: Not Run, Running, Passed, Failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontColor=#065F46;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="450" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="svc-constants" value="&lt;b&gt;Domain Constants &amp; Types&lt;/b&gt;&lt;br&gt;STATUSES, PRIORITIES, COMMENT_KINDS, DOCUMENT_TYPES, DOCUMENT_STATUSES, TEST_STATES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="520" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="svc-validation" value="&lt;b&gt;ValidationError &amp; LookupError&lt;/b&gt;&lt;br&gt;Domain exception classes for business rule validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;fontColor=#991B1B;align=center;fontSize=11;" vertex="1" parent="box-services">
          <mxGeometry x="20" y="580" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- Database Layer Container -->
        <mxCell id="box-db" value="&lt;b&gt;app.db &amp; SQLite Schema&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=13;" vertex="1" parent="1">
