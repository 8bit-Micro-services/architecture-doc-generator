        <mxCell id="e-u-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="node-host" source="proc-uvicorn" target="file-db">
          <mxGeometry relative="1" as="geometry" />
