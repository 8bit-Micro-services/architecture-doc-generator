        <mxCell id="subtitle" value="ISO/IEC/IEEE 12207, 29148, 42010 Aligned SDLC &amp; Architecture Document Generator" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
