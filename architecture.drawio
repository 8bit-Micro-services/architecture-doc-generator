        </mxCell>

        <!-- Core Workboard Modules inside Boundary -->
        <mxCell id="mod-dashboard" value="&lt;b&gt;Executive Dashboard &amp; Metrics&lt;/b&gt;&lt;br&gt;Task completion %, phase gate readiness, current work by role, quality metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="50" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mod-kanban" value="&lt;b&gt;ISO-Aligned SDLC Kanban Board&lt;/b&gt;&lt;br&gt;8 Phases (Intake → Retro), Gate-in / Gate-out checklists, role handoffs, blockers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="130" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mod-docs" value="&lt;b&gt;Architecture Document Registry&lt;/b&gt;&lt;br&gt;Document metadata, C4 diagrams, ADRs, lifecycle approval, linked tasks/reqs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="220" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mod-jobs" value="&lt;b&gt;Architecture Generation Tracker&lt;/b&gt;&lt;br&gt;Input specs (OpenAPI, TF, K8s) → Draw.io &amp; PPTX artifact tracking &amp; test state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="300" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mod-knowledge" value="&lt;b&gt;Department Knowledge Base&lt;/b&gt;&lt;br&gt;Department-scoped search (HR, IT, Finance, Ops), manual indexing lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="380" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mod-security-privacy" value="&lt;b&gt;Security &amp; AI Privacy Boundary&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mode: Manual Only&lt;/b&gt; (No external AI calls, PII isolation, zero cloud leakage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="40" y="460" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mod-sqlite" value="&lt;b&gt;Embedded SQLite Storage&lt;/b&gt;&lt;br&gt;Local database (&lt;code&gt;workboard.sqlite3&lt;/code&gt;) with foreign keys and WAL journal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=12;" vertex="1" parent="sys-boundary">
          <mxGeometry x="150" y="540" width="220" height="90" as="geometry" />
        </mxCell>

