          <mxGeometry x="80" y="500" width="50" height="90" as="geometry" />
        </mxCell>

        <mxCell id="actor-sec-ops" value="&lt;b&gt;Security &amp; DevOps Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569&quot;&gt;Threat models, secret scan, CI/CD, releases&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="80" y="670" width="50" height="90" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="sys-boundary" value="&lt;b&gt;SDLC Workboard System (Local MVP)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Loopback binding: 127.0.0.1&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#3B82F6;strokeWidth=2;dashed=0;fontColor=#0F172A;fontSize=14;" vertex="1" parent="1">
