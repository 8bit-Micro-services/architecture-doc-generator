  <diagram id="data-flow" name="Department Knowledge &amp; SDLC Data Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="title" value="SDLC Workboard - Data Flow &amp; Lifecycle Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Document Governance, Department Knowledge Search, and SDLC Quality Gate Transitions" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Swimlane 1: Document Lifecycle -->
        <mxCell id="lane-doc" value="&lt;b&gt;1. Document Lifecycle &amp; Governance Flow&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1080" height="200" as="geometry" />
        </mxCell>

        <mxCell id="dstep1" value="&lt;b&gt;1. Register Document&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Title, Type, Source/Path, Owner Role, Version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0369A1;" vertex="1" parent="lane-doc">
          <mxGeometry x="30" y="50" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dstep2" value="&lt;b&gt;2. Classify &amp; Assign Dept&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Assign exactly 1 Dept (HR / IT / Finance / Ops)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0369A1;" vertex="1" parent="lane-doc">
          <mxGeometry x="240" y="50" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dstep3" value="&lt;b&gt;3. Review &amp; Approval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Status: Draft → Under Review → Approved (Approver logged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0369A1;" vertex="1" parent="lane-doc">
          <mxGeometry x="450" y="50" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dstep4" value="&lt;b&gt;4. Indexing State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Not Indexed → Ready (or Needs Review)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontColor=#0369A1;" vertex="1" parent="lane-doc">
          <mxGeometry x="670" y="50" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dstep5" value="&lt;b&gt;5. Audited Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Stored in DB + document_activity audit log&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#BAE6FD;strokeColor=#0284C7;fontColor=#0369A1;" vertex="1" parent="lane-doc">
          <mxGeometry x="880" y="40" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-doc" source="dstep1" target="dstep2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-doc" source="dstep2" target="dstep3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-doc" source="dstep3" target="dstep4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-doc" source="dstep4" target="dstep5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: Department Knowledge Search (Manual Only) -->
        <mxCell id="lane-search" value="&lt;b&gt;2. Department Knowledge Search Flow (Manual Only Security Guard)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1080" height="200" as="geometry" />
        </mxCell>

        <mxCell id="kstep1" value="&lt;b&gt;User Search Query&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /knowledge?department=HR&amp;q=leave&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="lane-search">
          <mxGeometry x="30" y="50" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kstep2" value="&lt;b&gt;Department Boundary Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;If department is empty → return empty results&lt;br&gt;Strict isolation: HR data never leaks to IT/Finance&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;" vertex="1" parent="lane-search">
          <mxGeometry x="290" y="30" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="kstep3" value="&lt;b&gt;Parameterized SQL Filter&lt;/b&gt;&lt;br&gt;&lt;code&gt;WHERE department = ? AND (title LIKE ? OR content LIKE ?)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="lane-search">
          <mxGeometry x="560" y="50" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="kstep4" value="&lt;b&gt;Manual Render Only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Auto-escaped HTML render&lt;br&gt;AI Provider: NONE (Zero API egress)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="lane-search">
          <mxGeometry x="860" y="50" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ke1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-search" source="kstep1" target="kstep2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ke2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-search" source="kstep2" target="kstep3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ke3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-search" source="kstep3" target="kstep4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: SDLC Task & Quality Gates Flow -->
        <mxCell id="lane-sdlc" value="&lt;b&gt;3. ISO SDLC Task &amp; Quality Gate Execution Flow&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1080" height="230" as="geometry" />
        </mxCell>

        <mxCell id="tstep1" value="&lt;b&gt;Backlog / Intake&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Task created with Phase, Accountable &amp; Responsible roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;" vertex="1" parent="lane-sdlc">
          <mxGeometry x="30" y="60" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tstep2" value="&lt;b&gt;Gate-In Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Check prerequisite inputs &amp; entry criteria&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;" vertex="1" parent="lane-sdlc">
          <mxGeometry x="220" y="40" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tstep3" value="&lt;b&gt;In Progress &amp; Collab&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Responsible updates work, posts updates/blockers/decisions, records handoffs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;" vertex="1" parent="lane-sdlc">
          <mxGeometry x="420" y="60" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="tstep4" value="&lt;b&gt;Gate-Out Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;Are 100% of exit gate criteria checked?&lt;br&gt;If not → Cannot transition to Done&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#5B21B6;" vertex="1" parent="lane-sdlc">
          <mxGeometry x="650" y="40" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tstep5" value="&lt;b&gt;Done &amp; Phase Ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#475569;&quot;&gt;All tasks Done → Phase Readiness marked Ready. Overview percentage updated.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="lane-sdlc">
          <mxGeometry x="870" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="te1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-sdlc" source="tstep1" target="tstep2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-sdlc" source="tstep2" target="tstep3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-sdlc" source="tstep3" target="tstep4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te4" value="All Gates Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="lane-sdlc" source="tstep4" target="tstep5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

