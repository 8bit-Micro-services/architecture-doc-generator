<mxfile host="app.diagrams.net" modified="2026-10-07T00:00:00.000Z" agent="Mozilla/5.0" version="24.0.0">
  <diagram id="deployment-arch" name="Deployment Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="title" value="SDLC Workboard - Deployment Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Local Execution Target (Loopback / PyInstaller) vs Production Target Blueprint" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Current Local Environment Swimlane -->
        <mxCell id="env-local" value="&lt;b&gt;Current Implementation: Local Workstation Environment (Loopback 127.0.0.1)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="530" height="660" as="geometry" />
        </mxCell>

        <mxCell id="node-host" value="&lt;b&gt;Developer / User Host OS (Linux / macOS / Windows)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;" vertex="1" parent="env-local">
          <mxGeometry x="20" y="40" width="490" height="590" as="geometry" />
        </mxCell>

        <mxCell id="proc-browser" value="&lt;b&gt;User Browser Process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Navigates to http://127.0.0.1:&amp;lt;port&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontColor=#1E3A8A;" vertex="1" parent="node-host">
          <mxGeometry x="30" y="40" width="430" height="50" as="geometry" />
        </mxCell>

        <mxCell id="proc-launcher" value="&lt;b&gt;Python Launcher Process (app.launcher)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Binds ONLY to loopback 127.0.0.1; scans free ephemeral port or accepts --port&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontColor=#1E3A8A;" vertex="1" parent="node-host">
          <mxGeometry x="30" y="120" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="proc-uvicorn" value="&lt;b&gt;Uvicorn ASGI Server &amp; FastAPI Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;• Serves autoescaped Jinja2 HTML templates&lt;br&gt;• Mounts app/static/style.css&lt;br&gt;• Executes domain services in-process&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontColor=#1E3A8A;" vertex="1" parent="node-host">
          <mxGeometry x="30" y="210" width="430" height="90" as="geometry" />
        </mxCell>

        <mxCell id="file-db" value="&lt;b&gt;workboard.sqlite3 (Local File)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;SQLite database with WAL journal, auto-seeded on first run&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;" vertex="1" parent="node-host">
          <mxGeometry x="110" y="330" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="box-bundle" value="&lt;b&gt;Optional Standalone Onedir Package&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#78350F;&quot;&gt;PyInstaller --onedir --name SDLC-Workboard&lt;br&gt;Bundles templates, static CSS, Python runtime into dist/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;" vertex="1" parent="node-host">
          <mxGeometry x="30" y="430" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="box-sec-notice" value="&lt;b&gt;Local Security Posture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#991B1B;&quot;&gt;No public exposure; loopback only; no external AI calls; demo/fictional data only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#991B1B;" vertex="1" parent="node-host">
          <mxGeometry x="30" y="520" width="430" height="50" as="geometry" />
        </mxCell>

        <!-- Target Production Swimlane -->
        <mxCell id="env-prod" value="&lt;b&gt;Target / Future Blueprint: Hardened Enterprise Production Deployment&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="530" height="660" as="geometry" />
        </mxCell>

        <mxCell id="prod-tls" value="&lt;b&gt;Reverse Proxy &amp; TLS Gateway (Nginx / Ingress)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;HTTPS Termination, WAF, Rate Limiting, Request Inspection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;" vertex="1" parent="env-prod">
          <mxGeometry x="30" y="50" width="470" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prod-auth" value="&lt;b&gt;Authentication &amp; RBAC Gateway (OIDC / OAuth2 / SAML)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Department role validation, user session tokens, strict tenant context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;" vertex="1" parent="env-prod">
          <mxGeometry x="30" y="140" width="470" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prod-container" value="&lt;b&gt;Containerized Application Cluster (Kubernetes / ECS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;FastAPI containers running behind internal load balancer with health probes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;" vertex="1" parent="env-prod">
          <mxGeometry x="30" y="230" width="470" height="70" as="geometry" />
        </mxCell>

        <mxCell id="prod-db" value="&lt;b&gt;Managed PostgreSQL / Encrypted Datastore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Encryption at rest (AES-256), automated backups, department row-level security (RLS)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;" vertex="1" parent="env-prod">
          <mxGeometry x="110" y="330" width="310" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prod-audit" value="&lt;b&gt;SIEM / Audit Trail Logging Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Immutable audit trail of all document views, status updates, and gate toggles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontColor=#065F46;" vertex="1" parent="env-prod">
          <mxGeometry x="30" y="440" width="470" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prod-ai" value="&lt;b&gt;Isolated Enterprise RAG / AI Cluster (Optional / Future)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#475569;&quot;&gt;Self-hosted local LLM / Vector DB with strict per-department ACLs and zero data retention&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#581C87;" vertex="1" parent="env-prod">
          <mxGeometry x="30" y="530" width="470" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors Local -->
        <mxCell id="e-b-l" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="node-host" source="proc-browser" target="proc-launcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l-u" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="node-host" source="proc-launcher" target="proc-uvicorn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-u-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="node-host" source="proc-uvicorn" target="file-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connectors Prod -->
        <mxCell id="ep-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="env-prod" source="prod-tls" target="prod-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="env-prod" source="prod-auth" target="prod-container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="env-prod" source="prod-container" target="prod-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="env-prod" source="prod-container" target="prod-audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
