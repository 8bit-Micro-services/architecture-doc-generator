        <mxCell id="tbl-doc-act" value="&lt;b&gt;document_activity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#64748B;&quot;&gt;id, document_id, action, author, role, note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;fontColor=#4C1D95;align=left;spacingLeft=6;" vertex="1" parent="box-db">
