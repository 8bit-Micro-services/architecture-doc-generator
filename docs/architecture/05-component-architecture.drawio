        <mxCell id="tbl-tasks" value="&lt;b&gt;tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#64748B;&quot;&gt;id, title, phase_id, acc/resp, status, work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;fontColor=#4C1D95;align=left;spacingLeft=6;" vertex="1" parent="box-db">
