        </mxCell>

        <mxCell id="db-config" value="&lt;b&gt;Database Config &amp; PRAGMAs&lt;/b&gt;&lt;br&gt;• PRAGMA foreign_keys = ON&lt;br&gt;• PRAGMA journal_mode = WAL&lt;br&gt;• Auto-seed on first initialization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="box-db">
